<?xml version="1.0" encoding="utf-8"?>
<!--
  启动遮罩（v1.6.19 重做）。

  与旧版的三处结构性差别：
    1. **没有居中卡片**。旧的 340dp 白/深圆角卡片是「一块板」，在这种
       全屏等待场景里显得廉价；现在内容直接落在背景上，靠细环与留白成层次。
    2. **进度环成为视觉主体**，鲸鱼压在环心 —— 不再需要图标底衬。
    3. 步骤区与正文在同一个滚动容器里，避免嵌套滚动与「展开后卡片破洞」。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_bg"
    android:clickable="true"
    android:focusable="true"
    android:elevation="30dp"
                android:foreground="?android:attr/selectableItemBackground" >

    <ScrollView
        android:id="@+id/splashScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/splashBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginStart="@dimen/space_24"
                android:layout_marginEnd="@dimen/space_24"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="@dimen/space_72"
                android:paddingBottom="@dimen/space_32">

                <FrameLayout
                    android:layout_width="144dp"
                    android:layout_height="144dp">

                    <app.dsh.mobile.ui.SplashRingView
                        android:id="@+id/splashRing"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/splashLogo"
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_launcher_foreground"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/app_name"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_22"
                    android:gravity="center"
                    android:text="@string/app_name"
                    android:textColor="@color/splash_text"
                    android:textSize="@dimen/text_headline"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.025"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_10"
                    android:gravity="center"
                    android:text="@string/splash_tagline"
                    android:textColor="@color/splash_text_secondary"
                    android:textSize="@dimen/text_footnote"
                    android:lineSpacingExtra="2dp" />

                <LinearLayout
                    android:id="@+id/splashModeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_20"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/space_12"
                    android:paddingEnd="@dimen/space_14"
                    android:paddingTop="@dimen/space_8"
                    android:paddingBottom="@dimen/space_8"
                    android:background="@drawable/splash_mode_badge">

                    <View
                        android:id="@+id/splashModeDot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/splash_mode_dot"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_10"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/splashModeTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/splash_mode_detecting"
                            android:textColor="@color/splash_text_secondary"
                            android:textSize="@dimen/text_footnote"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/splashModeSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:text="@string/splash_ui_mode_waiting"
                            android:textColor="@color/splash_text_muted"
                            android:textSize="@dimen/text_caption"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_44"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/splashStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="32dp"
                        android:text="@string/splash_preparing"
                        android:textColor="@color/splash_text"
                        android:textSize="@dimen/text_title_xl"
                        android:fontFamily="sans-serif-medium"
                        android:lineSpacingExtra="3dp"
                        android:accessibilityLiveRegion="polite" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_10"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/splashElapsed"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/splash_text_secondary"
                            android:textSize="@dimen/text_footnote"
                            android:fontFamily="monospace" />

                        <TextView
                            android:id="@+id/splashPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:textColor="@color/splash_accent"
                            android:textSize="@dimen/text_footnote"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/splashDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:layout_marginTop="@dimen/space_10"
                        android:textColor="@color/splash_text_secondary"
                        android:textSize="@dimen/text_footnote"
                        android:lineSpacingExtra="4dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/space_14"
                        android:background="@color/splash_rule" />

                    <TextView
                        android:id="@+id/splashToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="@dimen/space_6"
                        android:paddingStart="@dimen/space_14"
                        android:paddingEnd="@dimen/space_14"
                        android:gravity="center"
                        android:text="@string/splash_show_steps"
                        android:textColor="@color/splash_accent"
                        android:textSize="@dimen/text_footnote"
                        android:background="@drawable/splash_pill"
                        android:clickable="true"
                        android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground" />

                    <LinearLayout
                        android:id="@+id/splashStepsPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_6"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/splashSteps"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="@dimen/space_4"
                            android:paddingBottom="@dimen/space_16"
                            android:textColor="@color/splash_text_secondary"
                            android:textSize="@dimen/text_caption"
                            android:fontFamily="monospace"
                            android:lineSpacingExtra="5dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</FrameLayout>
