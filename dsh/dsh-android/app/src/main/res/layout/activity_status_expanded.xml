<?xml version="1.0" encoding="utf-8"?>
<!-- 展开态状态栏设置（v1.5.x）
     背景图 + 贴纸。预览区就是按真实状态栏比例缩出来的一条胶囊。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/settings_page_bg">

    <LinearLayout style="@style/Widget.Dsh.Toolbar">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/Widget.Dsh.ToolbarIcon"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/settings_back" />

        <TextView
            style="@style/Widget.Dsh.ToolbarTitle"
            android:text="@string/setting_status_expanded" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingTop="@dimen/space_12"
            android:paddingBottom="@dimen/space_24">

            <!-- ===== 预览 ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_status_preview"
                android:textColor="@color/accent"
                android:textSize="@dimen/text_body_s"
                android:textStyle="bold"
                android:paddingStart="@dimen/space_8"
                android:paddingBottom="@dimen/space_8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_12"
                android:background="@drawable/bg_settings_card">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="@color/surface_alt">

                    <!-- 按真实状态栏比例缩出的胶囊；贴纸贴在它上面 -->
                    <FrameLayout
                        android:id="@+id/previewStatusBar"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:layout_marginHorizontal="@dimen/space_10"
                        android:background="@drawable/bg_dynamic_island" />

                    <TextView
                        android:id="@+id/txtPreviewHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="@dimen/space_6"
                        android:text="@string/setting_sticker_hint"
                        android:textColor="@color/settings_text_secondary"
                        android:textSize="@dimen/text_caption" />
                </FrameLayout>
            </LinearLayout>

            <!-- ===== 背景图 ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_status_bg"
                android:textColor="@color/accent"
                android:textSize="@dimen/text_body_s"
                android:textStyle="bold"
                android:paddingStart="@dimen/space_8"
                android:paddingTop="@dimen/space_18"
                android:paddingBottom="@dimen/space_8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="@dimen/space_12"
                android:background="@drawable/bg_settings_card">

                <Button
                    android:id="@+id/btnPickBg"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_6"
                    android:text="@string/action_choose_image"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_btn_accent_ripple"
                    android:textColor="@color/on_accent" />

                <Button
                    android:id="@+id/btnRemoveBg"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_6"
                    android:text="@string/action_remove_image"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_btn_outline_ripple"
                    android:textColor="@color/settings_text_primary" />
            </LinearLayout>

            <!-- ===== 贴纸 ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_status_stickers"
                android:textColor="@color/accent"
                android:textSize="@dimen/text_body_s"
                android:textStyle="bold"
                android:paddingStart="@dimen/space_8"
                android:paddingTop="@dimen/space_18"
                android:paddingBottom="@dimen/space_8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_12"
                android:background="@drawable/bg_settings_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_sticker_desc"
                    android:textColor="@color/settings_text_secondary"
                    android:textSize="@dimen/text_footnote"
                    android:layout_marginBottom="@dimen/space_12" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btnAddSticker"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/space_6"
                        android:text="@string/action_add_sticker"
                        android:textAllCaps="false"
                        android:background="@drawable/bg_btn_accent_ripple"
                        android:textColor="@color/on_accent" />

                    <Button
                        android:id="@+id/btnClearStickers"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_6"
                        android:text="@string/action_clear_stickers"
                        android:textAllCaps="false"
                        android:background="@drawable/bg_btn_outline_ripple"
                        android:textColor="@color/settings_text_primary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
