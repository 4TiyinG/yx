<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/settings_page_bg">

    <LinearLayout style="@style/Widget.Dsh.Toolbar">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/Widget.Dsh.ToolbarIcon"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/settings_back" />

        <TextView
            style="@style/Widget.Dsh.ToolbarTitle"
            android:text="@string/settings_section_appearance" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <app.dsh.mobile.MaxWidthLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingBottom="@dimen/space_32">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_settings_card"
                android:layout_marginTop="@dimen/space_14">

                <!-- 显示模式切换：亮/暗预览卡（对齐 Web 预览）。
                     v1.6.22：三项都不再使用 selectableItemBackgroundBorderless ——
                     无边界水波纹会扩散成一大团浅圆盖住整张卡（截图里那个大圆就是它）。
                     按压反馈改为 stateListAnimator 的 0.96 缩放，选中态改为
                     「预览卡 2dp 强调色描边 + 同色圆点」，与全页极简风格一致。 -->
                <LinearLayout
                    android:id="@+id/themePreviewCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_16"
                    android:paddingTop="@dimen/space_20"
                    android:paddingBottom="@dimen/space_12">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/optLightTheme"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/space_6"
                            android:stateListAnimator="@animator/press_scale">

                            <FrameLayout
                                android:id="@+id/previewLight"
                                android:layout_width="78dp"
                                android:layout_height="134dp"
                                android:background="@drawable/bg_theme_preview_light" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_10"
                                android:text="@string/theme_light"
                                android:textColor="@color/settings_text_primary"
                                android:textSize="@dimen/text_body" />

                            <View
                                android:id="@+id/radioLight"
                                android:layout_width="19dp"
                                android:layout_height="19dp"
                                android:layout_marginTop="@dimen/space_8"
                                android:background="@drawable/bg_radio_unselected" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/optDarkTheme"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/space_6"
                            android:stateListAnimator="@animator/press_scale">

                            <FrameLayout
                                android:id="@+id/previewDark"
                                android:layout_width="78dp"
                                android:layout_height="134dp"
                                android:background="@drawable/bg_theme_preview_dark" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_10"
                                android:text="@string/theme_dark"
                                android:textColor="@color/settings_text_primary"
                                android:textSize="@dimen/text_body" />

                            <View
                                android:id="@+id/radioDark"
                                android:layout_width="19dp"
                                android:layout_height="19dp"
                                android:layout_marginTop="@dimen/space_8"
                                android:background="@drawable/bg_radio_unselected" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 跟随系统（v1.6.22）：原来是一行光文本，选中只靠文字变蓝，
                         与上面两张卡的「圆点标记」是两套语言，读起来不一致。
                         现在它也带同一个 19dp 圆点，三个选项共用一套标记；
                         点击区域是整个容器（圆点+文字），按压只做缩放、无水波纹。 -->
                    <LinearLayout
                        android:id="@+id/optFollowTheme"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/space_2"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/space_14"
                        android:paddingVertical="@dimen/space_10"
                        android:stateListAnimator="@animator/press_scale">

                        <View
                            android:id="@+id/radioSystem"
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:background="@drawable/bg_radio_unselected" />

                        <TextView
                            android:id="@+id/valThemeFollow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_10"
                            android:text="@string/theme_system"
                            android:textColor="@color/settings_text_secondary"
                            android:textSize="@dimen/text_body_s" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/space_16"
                    android:layout_marginEnd="@dimen/space_16"
                    android:background="@color/settings_divider" />

<LinearLayout
                android:id="@+id/rowTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12"
                android:background="?android:attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_icon_circle_orange"
                    >
                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_theme"
                        android:tint="@color/on_chip" />
                </FrameLayout>

                <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/space_14">

                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_theme"
                android:textColor="@color/settings_text_primary"
                android:textSize="@dimen/text_body_l" />

                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_theme_sub"
                android:textColor="@color/settings_text_secondary"
                android:textSize="@dimen/text_footnote"
                android:layout_marginTop="@dimen/space_2" />
                </LinearLayout>

                <TextView
                android:id="@+id/valTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/settings_text_secondary"
                android:textSize="@dimen/text_body"
                android:layout_marginEnd="@dimen/space_6" />

                <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron" />
                </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="@dimen/row_text_indent_wide"
                        android:background="@color/settings_divider" />

<LinearLayout
                android:id="@+id/rowLandscape"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12"
                android:background="?android:attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_icon_circle_orange"
                    >
                    <ImageView
android:id="@+id/iconLandscape"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_rotate"
                        android:tint="@color/on_chip" />
                </FrameLayout>

                <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/space_14">

                <TextView
                android:id="@+id/lblLandscape"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_landscape"
                android:textColor="@color/settings_text_primary"
                android:textSize="@dimen/text_title" />

                <TextView
                android:id="@+id/subLandscape"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setting_landscape_sub"
                android:textColor="@color/settings_text_secondary"
                android:textSize="@dimen/text_footnote"
                android:layout_marginTop="@dimen/space_2" />
                </LinearLayout>

                <TextView
                android:id="@+id/valLandscape"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_orient_portrait"
                android:textColor="@color/settings_text_secondary"
                android:textSize="@dimen/text_body"
                android:layout_marginEnd="@dimen/space_6" />

                <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron" />
                </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="@dimen/row_text_indent_wide"
                        android:background="@color/settings_divider" />

                <!-- 设置页跟随屏幕方向（v1.5.x）：默认关 = 手机锁竖屏、平板跟随偏好 -->
                <LinearLayout
                android:id="@+id/rowSettingsFollow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12"
                android:background="?android:attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_icon_circle_orange"
                    >
                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_rotate"
                        android:tint="@color/on_chip" />
                </FrameLayout>

                <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/space_14">

                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_follow_orientation"
                android:textColor="@color/settings_text_primary"
                android:textSize="@dimen/text_title" />

                <TextView
                android:id="@+id/subSettingsFollow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setting_follow_orientation_sub"
                android:textColor="@color/settings_text_secondary"
                android:textSize="@dimen/text_footnote"
                android:layout_marginTop="@dimen/space_2" />
                </LinearLayout>

                <Switch
                android:id="@+id/swSettingsFollow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_10" />
                </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="@dimen/row_text_indent_wide"
                        android:background="@color/settings_divider" />

<LinearLayout
                android:id="@+id/rowScale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12"
                android:background="?android:attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_icon_circle_orange"
                    >
                    <ImageView
android:id="@+id/iconScale"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_scale"
                        android:tint="@color/on_chip" />
                </FrameLayout>

                <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/space_14">

                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_scale"
                android:textColor="@color/settings_text_primary"
                android:textSize="@dimen/text_title" />

                <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setting_scale_sub"
                android:textColor="@color/settings_text_secondary"
                android:textSize="@dimen/text_footnote"
                android:layout_marginTop="@dimen/space_2" />
                </LinearLayout>

                <TextView
                android:id="@+id/valScale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="90%"
                android:textColor="@color/settings_text_secondary"
                android:textSize="@dimen/text_body"
                android:layout_marginEnd="@dimen/space_6" />

                <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron" />
                </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="@dimen/row_text_indent_wide"
                        android:background="@color/settings_divider" />

<LinearLayout
                android:id="@+id/rowImmersive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12"
                android:background="?android:attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_icon_circle_orange"
                    >
                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_display"
                        android:tint="@color/on_chip" />
                </FrameLayout>

                <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/space_14">

                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_immersive"
                android:textColor="@color/settings_text_primary"
                android:textSize="@dimen/text_title" />

                <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setting_immersive_sub"
                android:textColor="@color/settings_text_secondary"
                android:textSize="@dimen/text_footnote"
                android:layout_marginTop="@dimen/space_2" />
                </LinearLayout>

                <Switch
                android:id="@+id/swImmersive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_10" />
                </LinearLayout>

                <!-- 隐藏状态栏（v1.6.50）：只对边到边模式有意义，紧凑模式下置灰 -->
                <LinearLayout
                android:id="@+id/rowHideStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12"
                android:background="?android:attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_icon_circle_orange">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_status_bar_off"
                        android:tint="@color/on_chip" />
                </FrameLayout>

                <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/space_14">

                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_hide_status"
                android:textColor="@color/settings_text_primary"
                android:textSize="@dimen/text_title" />

                <TextView
                android:id="@+id/valHideStatusSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setting_hide_status_sub"
                android:textColor="@color/settings_text_secondary"
                android:textSize="@dimen/text_footnote"
                android:layout_marginTop="@dimen/space_2" />
                </LinearLayout>

                <Switch
                android:id="@+id/swHideStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_10" />
                </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="@dimen/row_text_indent_wide"
                        android:background="@color/settings_divider" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="@dimen/row_text_indent_wide"
                        android:background="@color/settings_divider" />

                <!-- 官方推荐手机 UI（v1.4.67）：两套竖屏布局方案二选一 -->
                <LinearLayout
                android:id="@+id/rowOfficialUi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12"
                android:background="?android:attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_icon_circle_orange"
                    >
                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_display"
                        android:tint="@color/on_chip" />
                </FrameLayout>

                <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/space_14">

                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_official_ui"
                android:textColor="@color/settings_text_primary"
                android:textSize="@dimen/text_title" />

                <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setting_official_ui_sub"
                android:textColor="@color/settings_text_secondary"
                android:textSize="@dimen/text_footnote"
                android:layout_marginTop="@dimen/space_2" />
                </LinearLayout>

                <Switch
                android:id="@+id/swOfficialUi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_10" />
                </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="@dimen/row_text_indent_wide"
                        android:background="@color/settings_divider" />

<LinearLayout
                android:id="@+id/rowFilesDir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12"
                android:background="?android:attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_icon_circle_gray"
                    >
                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_folder"
                        android:tint="@color/on_chip" />
                </FrameLayout>

                <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/space_14">

                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_files_dir"
                android:textColor="@color/settings_text_primary"
                android:textSize="@dimen/text_title" />

                <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setting_files_dir_sub"
                android:textColor="@color/settings_text_secondary"
                android:textSize="@dimen/text_footnote"
                android:layout_marginTop="@dimen/space_2" />
                </LinearLayout>

                <TextView
                android:id="@+id/valFilesDir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="150dp"
                android:singleLine="true"
                android:ellipsize="middle"
                android:textColor="@color/settings_text_secondary"
                android:textSize="@dimen/text_footnote"
                android:layout_marginStart="@dimen/space_10" />
                </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="@dimen/row_text_indent_wide"
                        android:background="@color/settings_divider" />

<LinearLayout
                android:id="@+id/rowAccent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12"
                android:background="?android:attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_icon_circle_orange"
                    >
                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_palette"
                        android:tint="@color/on_chip" />
                </FrameLayout>

                <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/space_14">

                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_accent"
                android:textColor="@color/settings_text_primary"
                android:textSize="@dimen/text_body_l" />

                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_accent_sub"
                android:textColor="@color/settings_text_secondary"
                android:textSize="@dimen/text_footnote"
                android:layout_marginTop="@dimen/space_2" />
                </LinearLayout>

                <TextView
                android:id="@+id/valAccent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/settings_text_secondary"
                android:textSize="@dimen/text_body"
                android:layout_marginEnd="@dimen/space_6" />

                <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron" />
                </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
