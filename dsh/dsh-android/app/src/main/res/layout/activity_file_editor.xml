<?xml version="1.0" encoding="utf-8"?>
<!--
  应用内文件编辑页（v1.4.0，issue #25）。

  为什么需要这一页：上游「打开配置文件」把路径交给**桌面**文本编辑器
  （macOS `open -t` / Windows 资源管理器 / Linux `xdg-open`），Android 三者皆无，
  引擎直接抛 "native path opener is unsupported on android"。这里提供应用内的
  等价能力：读、改、原子保存，不依赖任何外部程序。

  结构刻意与 activity_user_prompt.xml 保持一致（同一套深色配色与返回栏），
  用户在两处之间的操作手感不割裂。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- 顶部栏：返回 + 文件名 + 保存 -->
    <LinearLayout style="@style/Widget.Dsh.Toolbar.Bg">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/Widget.Dsh.ToolbarIcon"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/settings_back" />

        <TextView
            style="@style/Widget.Dsh.ToolbarTitle"
            android:id="@+id/txtTitle"
            android:ellipsize="middle"
            android:singleLine="true"
            android:text="@string/file_editor_title" />

        <TextView
            android:id="@+id/btnReload"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="@dimen/space_12"
            android:text="@string/file_editor_reload"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="@dimen/space_18"
            android:text="@string/file_editor_save"
            android:textColor="@color/accent"
            android:textSize="@dimen/text_title"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- 路径行：显示真实路径，可复制（供 AI 会话里直接引用） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_16"
        android:paddingTop="@dimen/space_10">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/file_editor_path"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_footnote" />

        <TextView
            android:id="@+id/txtPath"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_8"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_footnote"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/btnCopyPath"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/space_8"
            android:paddingVertical="@dimen/space_2"
            android:text="@string/file_editor_copy_path"
            android:textColor="@color/accent"
            android:textSize="@dimen/text_footnote"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- 只读提示条：文件不可编辑（过大/非 UTF-8）时显示，此时隐藏保存按钮 -->
    <TextView
        android:id="@+id/txtNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/space_16"
        android:paddingTop="@dimen/space_10"
        android:textColor="@color/warning"
        android:textSize="@dimen/text_body_s"
        android:lineSpacingExtra="2dp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/editorFile"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/space_16"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginBottom="@dimen/space_16"
        android:padding="@dimen/space_14"
        android:gravity="top|start"
        android:inputType="textMultiLine|textNoSuggestions"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="@dimen/text_body"
        android:fontFamily="monospace"
        android:lineSpacingExtra="3dp"
        android:background="@drawable/bg_search_field"
        android:scrollbars="vertical" />
</LinearLayout>
