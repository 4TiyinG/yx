<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/settings_page_bg">

    <!-- 顶部栏：返回 + 标题（与设置页一致） -->
    <LinearLayout style="@style/Widget.Dsh.Toolbar">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/Widget.Dsh.ToolbarIcon"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/settings_back" />

        <TextView
            style="@style/Widget.Dsh.ToolbarTitle"
            android:text="@string/about_title" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <!-- v1.4.18：平板横屏下限宽居中，避免卡片被拉成整屏宽 -->
        <app.dsh.mobile.MaxWidthLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingBottom="@dimen/space_32">

            <!-- 应用标识卡 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/space_24"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/bg_settings_card">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_launcher" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_app_name"
                    android:textColor="@color/settings_text_primary"
                    android:textSize="@dimen/text_title_l"
                    android:textStyle="bold"
                    android:layout_marginTop="@dimen/space_12" />

                <TextView
                    android:id="@+id/txtVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/settings_text_secondary"
                    android:textSize="@dimen/text_body_s"
                    android:layout_marginTop="@dimen/space_4" />

                <!-- Fork 声明（仅 fork 构建可见）：避免把第三方分支包误认为上游正式包 -->
                <TextView
                    android:id="@+id/txtForkBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_fork_badge"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/text_footnote"
                    android:textStyle="bold"
                    android:layout_marginTop="@dimen/space_6"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 介绍卡：基本介绍 + 作者信息 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16"
                android:layout_marginTop="@dimen/space_14"
                android:background="@drawable/bg_settings_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_intro"
                    android:textColor="@color/settings_text_secondary"
                    android:textSize="@dimen/text_body"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_based"
                    android:textColor="@color/settings_text_secondary"
                    android:textSize="@dimen/text_footnote"
                    android:layout_marginTop="@dimen/space_10" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginVertical="@dimen/space_14"
                    android:background="@color/settings_divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_author"
                    android:textColor="@color/settings_text_primary"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 开源地址卡 -->
            <LinearLayout
                android:id="@+id/rowRepo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12"
                android:layout_marginTop="@dimen/space_14"
                android:background="@drawable/bg_settings_card"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@animator/press_scale" >

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_open_source"
                        android:textColor="@color/settings_text_primary"
                        android:textSize="@dimen/text_body_l" />

                    <TextView
                        android:id="@+id/txtRepo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent"
                        android:textSize="@dimen/text_body_s"
                        android:layout_marginTop="@dimen/space_2" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>

            <!-- QQ 交流群（v1.4.0）：点击复制群号。放在开源地址与检查更新之间 ——
                 这两张卡都是「出去找我们」的入口，群号属于同类，位置自然。 -->
            <LinearLayout
                android:id="@+id/rowQqGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12"
                android:layout_marginTop="@dimen/space_14"
                android:background="@drawable/bg_settings_card"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@animator/press_scale" >

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_qq_group"
                        android:textColor="@color/settings_text_primary"
                        android:textSize="@dimen/text_body_l" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/about_qq_group_id"
                        android:textColor="@color/accent"
                        android:textSize="@dimen/text_body_s"
                        android:fontFamily="monospace"
                        android:layout_marginTop="@dimen/space_2" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/space_6"
                    android:text="@string/about_qq_group_tap"
                    android:textColor="@color/settings_text_secondary"
                    android:textSize="@dimen/text_footnote" />
            </LinearLayout>

            <!-- Telegram 交流群（v1.4.38）：直接打开邀请链接。
                 QQ 那边只能复制群号（加群链接格式各版本不一），Telegram 有统一的
                 t.me 链接，可以真的点开。未安装 Telegram 时由浏览器兜底。 -->
            <LinearLayout
                android:id="@+id/rowTelegram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12"
                android:layout_marginTop="@dimen/space_14"
                android:background="@drawable/bg_settings_card"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@animator/press_scale" >

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_telegram"
                        android:textColor="@color/settings_text_primary"
                        android:textSize="@dimen/text_body_l" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/about_telegram_sub"
                        android:textColor="@color/accent"
                        android:textSize="@dimen/text_body_s"
                        android:layout_marginTop="@dimen/space_2" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/space_6"
                    android:text="@string/about_telegram_open"
                    android:textColor="@color/settings_text_secondary"
                    android:textSize="@dimen/text_footnote" />
            </LinearLayout>

            <!-- 求 star 卡片（v1.6.1）：放在仓库/社群之后、隐私声明之前。
                 用 accent 实心底色，是全页唯一的高饱和块 —— 这是有意为之，
                 它要抢眼但不该挡路，所以只占一行卡片高度、不做弹窗/浮层。 -->
            <LinearLayout
                android:id="@+id/rowStar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_16"
                android:layout_marginTop="@dimen/space_14"
                android:background="@drawable/bg_star_promo"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@animator/press_scale" >

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_star_white"
                    android:contentDescription="@string/about_star_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_12"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_star_title"
                        android:textColor="@color/on_chip"
                        android:textSize="@dimen/text_body_l"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/about_star_sub"
                        android:textColor="@color/on_chip_dim"
                        android:textSize="@dimen/text_footnote"
                        android:layout_marginTop="@dimen/space_4"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <!-- 行动标签：白底胶囊 + accent 文字（强调色由代码按当前配色涂） -->
                <TextView
                    android:id="@+id/txtStarAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_10"
                    android:background="@drawable/bg_star_action"
                    android:paddingHorizontal="@dimen/space_12"
                    android:paddingVertical="@dimen/space_6"
                    android:text="@string/about_star_action"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/text_footnote"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 隐私声明（v1.2.77）：主人要求写明自用服务器无任何监控 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_14"
                android:background="@drawable/bg_settings_card"
                android:padding="@dimen/space_16"
                android:text="@string/about_privacy_note"
                android:textColor="@color/settings_text_secondary"
                android:textSize="@dimen/text_footnote"
                android:lineSpacingExtra="3dp" />
        </app.dsh.mobile.MaxWidthLinearLayout>
    </ScrollView>
</LinearLayout>
