<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- WebView 全屏垫底：半透明工具栏悬浮其上（网页内容透出，浏览器质感） -->
    <!--
        importantForAccessibility="noHideDescendants"（v1.6.49）
        ─────────────────────────────────────────────────────────────
        本应用自带无障碍服务（供 Agent 读**别的** App），而只要服务开着且声明了
        canRetrieveWindowContent，**任何** WebView 都会为整棵 DOM 建虚拟无障碍节点树。
        400 轮会话上千节点，AI 每吐一个 token 就触发一次 DOM 变化 → 遍历 + 序列化 +
        跨进程派发，全部记在我们自己头上。这是「CPU 内存都富余、界面照样卡、
        profiler 按包名看没有热点」的典型形态 —— 开销不在我们的代码里。

        代价与边界（明确写下来，免得以后被当成 bug）：
          · Agent 不能再读**本应用聊天界面**的无障碍树 —— 对话内容它本来就在上下文里；
          · **截图不受影响**（takeScreenshot 与无障碍树是两条通路），视觉识别照旧；
          · 读**别的 App** 完全不受影响（scr 的主战场）；
          · 设置页/扩展中心等是独立 Activity，不在此列。
        回退：删掉这一行即可，其余代码零依赖。
    -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="noHideDescendants" />

    <!-- 安装/启动进度条：Installing 显示真实解压百分比，Starting 转不确定动画 -->
    <ProgressBar
        android:id="@+id/installProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:max="10000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="3dp"
        android:maxHeight="3dp"
        android:layout_gravity="top"
        android:layout_marginTop="@dimen/space_40"
        android:indeterminate="true"
        android:progressTint="@color/accent"
        android:progressBackgroundTint="@color/stroke"
        android:elevation="4dp"
        android:visibility="gone" />

    <!-- 灵动岛（收起态）：纯黑正圆 + 外围小光圈，直径与展开态高度一致，
         点它唤回工具栏。早期版本是宽胶囊 + 内部横条，收起后横向占位太宽、
         还会压到状态文字，故改为正圆。 -->
    <LinearLayout
        android:id="@+id/handleBar"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/space_10"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_dynamic_island_dot"
        android:elevation="10dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
                android:stateListAnimator="@animator/press_scale" >
        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_island_core_dot" />
    </LinearLayout>

    <!-- 灵动岛（展开态）：工具栏收进悬浮胶囊；宽度撑满留边距，竖屏也不裁切按钮。
         外层 FrameLayout 是贴纸图层：用户贴的图叠在胶囊上方，且与胶囊同进同退
         （位置/尺寸都由这个容器决定），不需要在贴纸自己身上再算坐标。 -->
    <FrameLayout
        android:id="@+id/statusBarOverlay"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="@dimen/space_12"
        android:layout_marginEnd="@dimen/space_12"
        android:layout_marginTop="@dimen/space_10"
        android:elevation="10dp">

    <LinearLayout
        android:id="@+id/statusBarRow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:background="@drawable/bg_dynamic_island"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/statusBar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="@dimen/space_18"
            android:paddingEnd="@dimen/space_6"
            android:textColor="@color/island_text"
            android:textSize="@dimen/text_body_s"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- 预览模式返回：仅当 WebView 位于非引擎端口的回环页面时显示 -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:padding="@dimen/space_10"
            android:src="@drawable/ic_back"
            android:tint="@color/island_success"
            android:visibility="gone"
            android:contentDescription="@string/btn_back"
            android:background="@drawable/bg_island_btn" />

        <!-- 重启 / 启动引擎（v1.6.47 重新设计）
             原来它与右侧「刷新」是**同一个字形**（ic_restart 与 ic_web_refresh 的
             path 数据一致，只差逗号空格），又同色、同尺寸、同背景 —— 胶囊上并排
             两枚一模一样的按钮，用户只能靠位置猜。

             现在用两重、互相独立的线索区分（任一失效仍可分辨）：
               ① 字形：电源符号（ic_power）＝ 会中断当前会话的重活；
                        循环箭头（ic_web_refresh）＝ 只重画页面的轻活。
               ② 颜色：琥珀 island_warn ＝ 重活；蓝 island_accent ＝ 轻活。
             尺寸/内边距/涟漪仍与同排按钮完全一致，不破坏胶囊节奏。 -->
        <ImageView
            android:id="@+id/btnRestart"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:padding="@dimen/space_10"
            android:src="@drawable/ic_power"
            android:tint="@color/island_warn"
            android:contentDescription="@string/btn_restart"
            android:tooltipText="@string/btn_restart"
            android:background="@drawable/bg_island_btn" />

        <!-- 原生终端入口：跳转独立终端页（真 PTY，自带 bash） -->
        <ImageView
            android:id="@+id/btnTerminal"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:padding="@dimen/space_10"
            android:src="@drawable/ic_terminal"
            android:tint="@color/island_accent"
            android:contentDescription="@string/btn_terminal"
            android:background="@drawable/bg_island_btn" />

        <!-- Web 界面刷新（v1.6.33 加入，v1.6.47 重新校准视觉）
             软刷新当前 Web 视图（引擎 WebUI 或预览页），不重启引擎。
             与「重启」的区分见上面那段注释：循环箭头 + 蓝色 ＝ 轻活。
             按下时图标自转一圈（MainActivity 里的 rotationBy），既是反馈也是
             "正在重取页面"的隐喻；转动只动 transform，不触发重排。 -->
        <ImageView
            android:id="@+id/btnRefresh"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:padding="@dimen/space_10"
            android:src="@drawable/ic_web_refresh"
            android:tint="@color/island_accent"
            android:contentDescription="@string/btn_refresh_web"
            android:tooltipText="@string/btn_refresh_web"
            android:background="@drawable/bg_island_btn" />

        <!-- 状态栏（通知栏）显隐（v1.6.50）
             只在边到边模式下显示 —— 紧凑模式必须保留状态栏（那是用户选的形态），
             此时按钮自身的 visibility 由 MainActivity.updateStatusBarToggle 置 GONE。
             默认隐藏状态栏（偏好缺省 true）：进入边到边即全屏沉浸，
             状态栏随时可通过这一枚按钮（或设置页开关）放回来，即时生效、不重建 Activity。 -->
        <ImageView
            android:id="@+id/btnStatusBar"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:padding="@dimen/space_10"
            android:src="@drawable/ic_status_bar_off"
            android:tint="@color/island_accent"
            android:contentDescription="@string/btn_status_bar"
            android:tooltipText="@string/btn_status_bar"
            android:background="@drawable/bg_island_btn" />

        <!-- 隐藏工具栏：一键让网页全屏（点顶部小把手唤回） -->
        <ImageView
            android:id="@+id/btnHide"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:padding="@dimen/space_10"
            android:src="@drawable/ic_chevron"
            android:tint="@color/island_text"
            android:contentDescription="@string/btn_hide"
            android:background="@drawable/bg_island_btn" />

        <!-- 设置入口：齿轮图标（跳转独立设置页） -->
        <ImageView
            android:id="@+id/btnMore"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:padding="@dimen/space_10"
            android:layout_marginEnd="@dimen/space_2"
            android:src="@drawable/ic_settings"
            android:tint="@color/island_text"
            android:background="@drawable/bg_island_btn"
            android:contentDescription="@string/settings_title" />
    </LinearLayout>
    </FrameLayout>

    <!-- ==================== 启动动画（v1.3.1） ====================
         冷启动时运行时解压 + 引擎启动需要时间，之前这段时间是一块空黑屏（用户反馈）。
         这里用一层品牌遮罩盖住：logo 淡入 + 轻微呼吸、真实解压百分比、
         状态文案随引擎阶段变化；WebView 首屏加载完成后淡出。
         clickable/focusable：遮罩期间吞掉误触，避免用户点到下面还没就绪的界面。 -->
        <include layout="@layout/view_boot_splash" />
</FrameLayout>
