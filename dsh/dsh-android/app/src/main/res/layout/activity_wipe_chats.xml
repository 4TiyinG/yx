<?xml version="1.0" encoding="utf-8"?>
<!-- 删除对话（v1.6.17）：会话列表 + 多选 + 一键清空。
     结构沿用 About / 维护页：顶栏 + 说明 + 卡片列表 + 底部操作条。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/settings_page_bg">

    <!-- 顶部栏：返回 + 标题 + 全选 -->
    <LinearLayout style="@style/Widget.Dsh.Toolbar">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/Widget.Dsh.ToolbarIcon"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/settings_back" />

        <TextView
            style="@style/Widget.Dsh.ToolbarTitle"
            android:text="@string/wipe_chats_title" />

        <TextView
            android:id="@+id/btnSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_16"
            android:text="@string/wipe_chats_select_all"
            android:textColor="@color/accent"
            android:textSize="@dimen/text_body_s"
            android:paddingHorizontal="@dimen/space_10"
            android:paddingVertical="@dimen/space_6"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtWipeHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/space_24"
        android:paddingTop="@dimen/space_12"
        android:paddingBottom="@dimen/space_10"
        android:text="@string/wipe_chats_hint"
        android:textColor="@color/settings_text_secondary"
        android:textSize="@dimen/text_footnote" />

    <!-- 筛选标签（v1.6.28）：全部 / 进行中 / 已归档。
         归档会话本来就在扫描结果里（engine 的 global.archivedSessionIds），
         这里只做分类展示，不额外读盘 —— 切换标签是纯内存重排，不重新扫描。 -->
    <LinearLayout
        android:id="@+id/boxFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_20"
        android:paddingBottom="@dimen/space_10">

        <TextView
            android:id="@+id/chipAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_footnote"
            android:paddingHorizontal="@dimen/space_12"
            android:paddingVertical="@dimen/space_6"
            android:background="@drawable/bg_btn_accent"
            android:textColor="@color/on_accent" />

        <TextView
            android:id="@+id/chipActive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:textSize="@dimen/text_footnote"
            android:paddingHorizontal="@dimen/space_12"
            android:paddingVertical="@dimen/space_6"
            android:background="@drawable/bg_btn_outline"
            android:textColor="@color/accent" />

        <TextView
            android:id="@+id/chipArchived"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:textSize="@dimen/text_footnote"
            android:paddingHorizontal="@dimen/space_12"
            android:paddingVertical="@dimen/space_6"
            android:background="@drawable/bg_btn_outline"
            android:textColor="@color/accent" />
    </LinearLayout>

    <!-- 加载态：会话枚举在后台线程，期间显示进度而不是空白 -->
    <LinearLayout
        android:id="@+id/boxLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_24"
        android:paddingVertical="@dimen/space_18">

        <ProgressBar
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:text="@string/wipe_chats_loading"
            android:textColor="@color/settings_text_secondary"
            android:textSize="@dimen/text_body_s" />
    </LinearLayout>

    <!-- 空态 -->
    <TextView
        android:id="@+id/txtEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/space_24"
        android:paddingVertical="@dimen/space_24"
        android:text="@string/wipe_chats_empty"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_body_s"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <app.dsh.mobile.MaxWidthLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingBottom="@dimen/space_16">

            <LinearLayout
                android:id="@+id/listChats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_settings_card" />
        </app.dsh.mobile.MaxWidthLinearLayout>
    </ScrollView>

    <!-- 底部操作条：选中计数 + 删除按钮。无选中时按钮禁用，避免误触。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_20"
        android:paddingVertical="@dimen/space_12"
        android:background="@color/settings_page_bg"
        android:elevation="6dp">

        <TextView
            android:id="@+id/txtSelection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/wipe_chats_none_selected"
            android:textColor="@color/settings_text_secondary"
            android:textSize="@dimen/text_body_s" />

        <TextView
            android:id="@+id/btnDeleteSelected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wipe_chats_delete_selected"
            android:textColor="@color/on_accent"
            android:textSize="@dimen/text_body_s"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_accent"
            android:paddingHorizontal="@dimen/space_18"
            android:paddingVertical="@dimen/space_10"
            android:alpha="0.4" />

        <TextView
            android:id="@+id/btnClearAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_10"
            android:text="@string/wipe_chats_clear_all"
            android:textColor="@color/danger"
            android:textSize="@dimen/text_body_s"
            android:background="@drawable/bg_btn_outline"
            android:paddingHorizontal="@dimen/space_18"
            android:paddingVertical="@dimen/space_10" />
    </LinearLayout>
</LinearLayout>
