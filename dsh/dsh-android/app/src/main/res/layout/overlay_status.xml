<?xml version="1.0" encoding="utf-8"?>
<!--
  AI 状态悬浮窗（v1.2.58 初版，v1.2.65 三段式重做）

  三段形态（点一下升一档）：
    ① 折叠态  —— 只有一个**圆形半透明状态点**，尽量不挡视线
    ② 展开态  —— 状态点 + 状态文字（空闲/执行中）+ 麦克风按钮
    ③ 详情态  —— 在②基础上追加：最近动作 + 活跃会话列表（名称/最后活跃时间）

  颜色语义与设置页一致：强调蓝=执行中 / 绿=完成 / 灰=空闲 / 红=录音中。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_overlay_panel"
    android:paddingStart="@dimen/space_10"
    android:paddingEnd="@dimen/space_12"
    android:paddingTop="@dimen/space_8"
    android:paddingBottom="@dimen/space_8"
    android:minWidth="0dp"
    android:elevation="8dp">

    <!-- 状态行：圆点 + 主文案 + 麦克风（折叠态只显示圆点，其余由代码控制可见性） -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 状态点：两种形态同尺寸 14dp（DOT_DP，见 StatusOverlay）——
             10dp 在展开态偏小、与折叠态切换时大小跳动 -->
        <View
            android:id="@+id/overlayDot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="@dimen/space_8"
            android:background="@drawable/bg_overlay_dot" />

        <TextView
            android:id="@+id/overlayStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_body_s"
            android:textStyle="bold"
            android:letterSpacing="0.01"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="DSH" />

        <!-- 语音输入按钮：点击开始/停止录音识别 -->
        <ImageView
            android:id="@+id/overlayMic"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="@dimen/space_8"
            android:padding="@dimen/space_4"
            android:src="@drawable/ic_mic"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/a11y_voice_input"
            android:scaleType="fitCenter" />

        <!-- Web 界面刷新按钮（v1.6.32）：点击软刷新当前 Web 视图（引擎页或预览页）。
             与麦克风完全同规格（22dp/3dp 内边距/无边框涟漪/icon_color 着色），视觉上
             只是状态行尾部多一枚同风格图标，完全融入现有悬浮窗设计。 -->
        <ImageView
            android:id="@+id/overlayRefresh"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="@dimen/space_4"
            android:padding="@dimen/space_4"
            android:src="@drawable/ic_web_refresh"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/a11y_web_refresh"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <!-- 动作行：展开态可见（AI 最近在做什么） -->
    <TextView
        android:id="@+id/overlayAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:layout_marginStart="@dimen/space_16"
        android:textSize="@dimen/text_caption"
        android:textColor="@color/text_muted"
        android:maxLines="2"
        android:ellipsize="end"
        android:visibility="gone"
        android:text="" />

    <!-- 详情态：活跃会话列表（容器由代码填充，避免 XML 写死条目数） -->
    <LinearLayout
        android:id="@+id/overlaySessions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/space_6"
        android:visibility="gone" />
</LinearLayout>
