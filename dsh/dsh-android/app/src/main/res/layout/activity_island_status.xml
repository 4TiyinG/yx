<?xml version="1.0" encoding="utf-8"?>
<!-- 收起态状态栏设置（v1.5.x）
     状态栏收起成小圆点时显示什么：自定义图片（圆形/方形可切换）、以及圆点大小。
     默认（不设图）就是原来那个「深色圆 + 中心小亮核」。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/settings_page_bg">

    <LinearLayout style="@style/Widget.Dsh.Toolbar">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/Widget.Dsh.ToolbarIcon"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/settings_back" />

        <TextView
            style="@style/Widget.Dsh.ToolbarTitle"
            android:text="@string/setting_island_dot_image" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingTop="@dimen/space_12"
            android:paddingBottom="@dimen/space_24">

            <!-- ===== 预览 + 选择/移除 ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingVertical="@dimen/space_20"
                android:background="@drawable/bg_settings_card">

                <!-- 预览容器：按所选形状/尺寸实时变化 -->
                <!-- 预览：结构与主界面真实的 handleBar 完全一致 ——
                     外层容器（默认背景 bg_dynamic_island_dot）+ 中心小亮核，
                     渲染逻辑走同一份 IslandDotRenderer，做到"预览即所得"。 -->
                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp">

                    <LinearLayout
                        android:id="@+id/previewDot"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_dynamic_island_dot">

                        <View
                            android:id="@+id/previewDotCore"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_island_core_dot" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/txtDotHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_image_none"
                    android:textColor="@color/settings_text_secondary"
                    android:textSize="@dimen/text_footnote"
                    android:layout_marginTop="@dimen/space_10" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="@dimen/space_14">

                    <Button
                        android:id="@+id/btnPickDot"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/space_6"
                        android:text="@string/action_choose_image"
                        android:textAllCaps="false"
                        android:background="@drawable/bg_btn_accent_ripple"
                        android:textColor="@color/on_accent" />

                    <Button
                        android:id="@+id/btnRemoveDot"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_6"
                        android:text="@string/action_remove_image"
                        android:textAllCaps="false"
                        android:background="@drawable/bg_btn_outline_ripple"
                        android:textColor="@color/settings_text_primary" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 形状 ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_dot_shape"
                android:textColor="@color/accent"
                android:textSize="@dimen/text_body_s"
                android:textStyle="bold"
                android:paddingStart="@dimen/space_8"
                android:paddingTop="@dimen/space_18"
                android:paddingBottom="@dimen/space_8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_settings_card">

                <LinearLayout
                    android:id="@+id/rowShapeCircle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/space_16"
                    android:paddingVertical="@dimen/space_14"
                    android:background="?android:attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setting_dot_shape_circle"
                        android:textColor="@color/settings_text_primary"
                        android:textSize="@dimen/text_body_l" />

                    <ImageView
                        android:id="@+id/chkShapeCircle"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_check" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/space_16"
                    android:background="@color/settings_divider" />

                <LinearLayout
                    android:id="@+id/rowShapeSquare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/space_16"
                    android:paddingVertical="@dimen/space_14"
                    android:background="?android:attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setting_dot_shape_square"
                        android:textColor="@color/settings_text_primary"
                        android:textSize="@dimen/text_body_l" />

                    <ImageView
                        android:id="@+id/chkShapeSquare"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_check" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 尺寸 ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_dot_size"
                android:textColor="@color/accent"
                android:textSize="@dimen/text_body_s"
                android:textStyle="bold"
                android:paddingStart="@dimen/space_8"
                android:paddingTop="@dimen/space_18"
                android:paddingBottom="@dimen/space_8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_14"
                android:background="@drawable/bg_settings_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setting_dot_size_sub"
                        android:textColor="@color/settings_text_secondary"
                        android:textSize="@dimen/text_footnote" />

                    <TextView
                        android:id="@+id/valDotSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekDotSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:max="46"
                    android:progressTint="@color/accent"
                    android:thumbTint="@color/accent"
                    android:progressBackgroundTint="@color/stroke" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
