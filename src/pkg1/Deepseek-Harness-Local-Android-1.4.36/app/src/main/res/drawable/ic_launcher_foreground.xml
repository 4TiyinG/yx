<?xml version="1.0" encoding="utf-8"?>
<!-- 毛玻璃应用图标前景（v1.9.1）
     玻璃面板：径向渐变（中心偏暗、四周受光）+ 顶部薄雾高光 + 1.5dp 白色内描边，最后叠加白鲸字标。
     适配 adaptive icon 108dp 层，圆角 24dp 与原图标一致；矢量实现，不再依赖 PNG。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 玻璃底 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerColor="#FF121416"
                android:centerX="0.5"
                android:centerY="0.42"
                android:endColor="#FF42464A"
                android:gradientRadius="72dp"
                android:startColor="#FF060708"
                android:type="radial" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- 顶部薄雾高光 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#26FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- 玻璃内描边 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1.5dp"
                android:color="#59FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- 白鲸 + HARNESS 字标 -->
    <item android:drawable="@drawable/ic_whale_logo" />
</layer-list>
