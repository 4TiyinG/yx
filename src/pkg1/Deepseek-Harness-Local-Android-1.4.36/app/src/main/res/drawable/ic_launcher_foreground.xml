<?xml version="1.0" encoding="utf-8"?>
<!-- 毛玻璃应用图标前景（v1.9.2）
     玻璃面做满幅（full-bleed）：渐变铺满整个 108dp 层，不画方形边线，
     这样被启动器的圆形/方圆遮罩裁切时不会露出"被切掉的图标边缘"；
     白鲸与 HARNESS 字标整体收在 66dp 安全圈内，任何遮罩下都完整可见。纯矢量，无 PNG。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 玻璃面：中心偏暗、四周受光 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerColor="#FF15181A"
                android:centerX="0.5"
                android:centerY="0.42"
                android:endColor="#FF45494D"
                android:gradientRadius="76dp"
                android:startColor="#FF060708"
                android:type="radial" />
        </shape>
    </item>
    <!-- 顶部薄雾高光 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#1FFFFFFF" />
        </shape>
    </item>
    <!-- 白鲸 + HARNESS 字标 -->
    <item android:drawable="@drawable/ic_whale_logo" />
</layer-list>
